# Copy this file to librarytools-auth.env (next to docker-compose.yml) and
# fill in. This file must never be committed (see .gitignore).

# --- KTH Login (OpenID Connect via Microsoft Entra ID / KTH's ADFS) ---
# Same reused Entra app registration bookingtools used before this split —
# its only allowed redirect URI is https://apps.lib.kth.se/mrbs (or the ref
# equivalent), which is exactly the path this service owns.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=

# Optional: Entra/KTH group object-id whose members get isGroupAdmin=true in
# the identity token this service issues. Leave empty to always issue false.
OIDC_ADMIN_GROUP_ID=

# --- Identity token signing ---
# Ed25519 private key, PKCS8 PEM on ONE line with literal \n escapes - an
# env_file can't hold a multi-line value, the container would only get the
# BEGIN line. Generate a new key per environment, already on one line, with:
#   openssl genpkey -algorithm ed25519 | awk '{printf "%s\\n", $0}' | sed 's/\\n$//'
# and paste it unquoted after the =. Only this service ever holds it — consuming apps verify tokens against
# the public JWKS this service publishes at /mrbs/.well-known/jwks.json,
# never against this secret directly.
AUTH_SIGNING_PRIVATE_KEY=

# The cookie domain the identity token is set on, so it reaches every app on
# the shared domain (e.g. apps.lib.kth.se or apps-ref.lib.kth.se).
COOKIE_DOMAIN=apps.lib.kth.se

# Fallbacks for apps that don't pass returnTo / errorTo to /mrbs/login.
# Keep them app-neutral: the host's start page, and this service's own
# simple error page (which gets ?error=<code>). These are also the defaults
# when left empty.
DEFAULT_RETURN_TO=/
LOGIN_ERROR_PATH=/mrbs/error
